{
  "name": "obsidian-vault-agenda",
  "version": "0.6.3",
  "description": "Plan dated notes and file-based tasks in a compact calendar, with lists, repeats, and overdue tracking.",
  "main": "main.js",
  "type": "module",
  "author": "Eugene Lesnov",
  "license": "MIT",
  "keywords": [
    "obsidian-plugin"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@eslint/json": "0.14.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.10",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "~1.13.1",
    "tslib": "^2.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.10"
  }
}
